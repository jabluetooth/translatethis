# --- Required for the core translate flow ---
# Get one at https://console.groq.com/keys
GROQ_API_KEY=
# Optional override; defaults to openai/gpt-oss-120b (see src/lib/constants.ts)
# Full catalog: https://console.groq.com/docs/models
GROQ_MODEL=

# --- Anonymous rate limiting (optional) ---
# Without these, rate limiting falls back to an in-process Map — fine for
# local dev, NOT safe across multiple server instances/regions. Get values
# at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth (via src/proxy.ts / clerkMiddleware()) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Database (v1.5+ history / team glossary — not on the MVP translate path) ---
# Provision at https://supabase.com/. Get both from the project's "Connect"
# button. DATABASE_URL = transaction pooler (port 6543) — used by the app at
# runtime (src/lib/db/client.ts sets prepare:false, required for that mode).
# DIRECT_URL = session pooler (port 5432, same host/credentials, just the
# port) — used only by `npm run db:generate|migrate`, since the transaction
# pooler doesn't support the session semantics migrations need. Passwords
# with special characters must be percent-encoded (e.g. "!" -> "%21").
DATABASE_URL=
DIRECT_URL=

# --- Payments (PayMongo — sells a one-time 30-day Pro pass, not a
# recurring subscription; PayMongo's hosted Checkout only does one-time
# payments, see src/lib/paymongo.ts for why) ---
# Get PAYMONGO_SECRET_KEY (test mode: sk_test_...) from
# https://dashboard.paymongo.com/ under Developers > API keys.
PAYMONGO_SECRET_KEY=
# Create a webhook endpoint (Developers > Webhooks) pointing at
# <your-deployed-url>/api/paymongo/webhook, listening for
# checkout_session.payment.paid — PayMongo shows the signing secret once,
# on creation. Locally, since Paymongo's servers can't reach localhost,
# simulate a signed event instead of relying on real delivery.
PAYMONGO_WEBHOOK_SECRET=

# --- Monitoring (optional, no-ops if unset) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
